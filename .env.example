# Flow Guardian Environment Variables
# Copy this file to .env and fill in your API keys

# Cerebras Cloud API Key
# Get yours at: https://cloud.cerebras.ai
CEREBRAS_API_KEY=csk-xxx

# Backboard.io API Key
# Get yours at: https://backboard.io/hackathons/ (use code: 8090JAN)
BACKBOARD_API_KEY=bb-xxx

# Backboard API Base URL (usually don't need to change)
BACKBOARD_BASE_URL=https://app.backboard.io/api
